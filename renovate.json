{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "ignorePaths": [
    "secrets/**"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)(apps|dns|platform|sources)/.*\\.ya?ml$/",
      "/(^|/)gotk-components\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Blocky is pinned to a pre-release digest until a release carries the DNSSEC fix. The latest stable release SERVFAILs .io.",
      "matchFileNames": ["dns/blocky.yaml"],
      "matchDatasources": ["docker"],
      "enabled": false
    },
    {
      "description": "Local charts install from git. A chart version makes Flux keep the first package.",
      "matchFileNames": [
        "apps/paperless.yaml",
        "apps/pocket-id.yaml",
        "apps/norish.yaml",
        "apps/oauth2-proxy-norish.yaml",
        "apps/oauth2-proxy-paperless.yaml",
        "apps/oauth2-proxy-open-webui.yaml",
        "platform/volume-backup/helmrelease.yaml",
        "platform/generic-cdi-plugin.yaml"
      ],
      "matchDepTypes": ["HelmChart"],
      "enabled": false
    },
    {
      "description": "Flux component manifest. Review the generated diff.",
      "matchFileNames": ["clusters/helios/flux-system/gotk-components.yaml"],
      "automerge": false,
      "addLabels": ["flux"]
    },
    {
      "description": "Image patches for stateless apps. Rollback is reverting the tag. TODO: review this automerge when main has protection.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "digest"],
      "matchPackageNames": [
        "/ollama\\/ollama/",
        "/open-webui\\/open-webui/",
        "/gotenberg\\/gotenberg/",
        "/apache\\/tika/"
      ],
      "minimumReleaseAge": "3 days",
      "schedule": ["* 8-20 * * *"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["automerge"]
    },
    {
      "description": "Majors stay open for review.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    },
    {
      "description": "Postgres majors need a dump and restore. Never automerge.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^postgres$/", "/^library\\/postgres$/"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"],
      "prBodyNotes": [
        "A Postgres major will not open the previous data files. Dump the database and restore it into an empty data directory. Do not copy the files."
      ]
    }
  ]
}
